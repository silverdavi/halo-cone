.venv*/
__pycache__/
*.pyc
.DS_Store

# Credentials: never in this tree
.env
.env.*
*.env
venues.env
*.key
*.pem
.cdsapirc

# Browser automation (portal sessions, screenshots)
.browser-profile/
**/.browser-profile/
**/screenshots/
**/portal_shots/

# Downloaded inputs: XENONnT light-WIMP release (Zenodo 10.5281/zenodo.14522707, v0.0.1),
# CRESST-III Detector A (arXiv:1905.07335 ancillary files), solar fluxes. fetch_data.sh restores them.
data/
# cached mono-energetic response grid (rebuilt by analysis.py from the release)
results/mono_grid.npz

# Manuscript text and journal submission package: not public before acceptance
# (the manuscript is not posted as a preprint). numbers.tex, tables/ and figs/ are code outputs and are kept.
paper/main.tex
paper/macros.tex
paper/sections/
paper/*.pdf
submissions/

# LaTeX build files
paper/*.aux
paper/*.log
paper/*.out
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*Notes.bib

# Cycles renders and composition scratch for Fig. 1 (regenerated by run_all.sh; the composed figure is in paper/figs)
viz/out/*_preview_*
viz/out/shell.svg

# Cover art renders (hero/ scripts are kept; outputs are large and not part of the paper)
hero/out/
hero/*.svg
hero/*.png
